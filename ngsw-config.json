{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.png",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/fonts/*.css"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "bible-almeida",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/bible/index.json",
          "/bible/almeida/*.json"
        ]
      }
    },
    {
      "name": "conteudo",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/conteudo/**"
        ]
      }
    },
    {
      "name": "versoes-portugues",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/bible/blivre/*.json",
          "/bible/nbv/*.json",
          "/bible/bpm/*.json",
          "/bible/blt/*.json",
          "/bible/nva/*.json",
          "/bible/alm1911/*.json"
        ]
      }
    },
    {
      "name": "referencias",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/bible/referencias/*.json"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "bible-text",
      "urls": [
        "https://bible-api.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 3000,
        "maxAge": "365d"
      }
    }
  ]
}
